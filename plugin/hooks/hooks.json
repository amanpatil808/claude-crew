{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/hooks/projects.mjs\" register",
            "async": true,
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/board/hook.ts\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/board/hook.ts\"", "async": true, "timeout": 5 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/board/hook.ts\"", "async": true, "timeout": 5 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/board/hook.ts\"", "async": true, "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Agent|SendMessage",
        "hooks": [
          { "type": "command", "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/board/hook.ts\"", "async": true, "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/board/hook.ts\"", "async": true, "timeout": 5 }
        ]
      }
    ]
  }
}
