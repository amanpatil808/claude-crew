{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|Edit|Write|MultiEdit|NotebookEdit|Agent|^(Task|SendMessage|CronCreate|Workflow|RemoteTrigger|Read|Grep)$|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/hooks/projects.mjs\" register",
            "async": true
          },
          {
            "type": "command",
            "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/board/hook.ts\"",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/board/hook.ts\"", "async": true }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/board/hook.ts\"", "async": true }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/board/hook.ts\"", "async": true }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Agent|SendMessage",
        "hooks": [
          { "type": "command", "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/board/hook.ts\"", "async": true }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/board/hook.ts\"", "async": true }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input",
        "hooks": [
          { "type": "command", "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/board/hook.ts\"", "async": true }
        ]
      }
    ]
  }
}
